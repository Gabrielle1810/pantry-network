# Pantry Network — environment variables (example)
# Copy to .env.local for local dev. NEVER commit a real .env file.
# All of these are server-only. Never prefix any key with NEXT_PUBLIC_.

# --- Staff access gate ---
# The PIN staff type to unlock the app. Choose your own; never commit it.
STAFF_PIN=
# HMAC signing key for the session cookie. Independent of STAFF_PIN.
# Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Campus ---
# Time zone for "today" and received dates (never UTC).
CAMPUS_TZ=America/New_York

# --- Vision provider ---
# VISION_PROVIDER: "gemini" | "anthropic" | "mock". Falls back to mock if the
# selected provider has no API key. Gemini is the current default (free tier).
VISION_PROVIDER=gemini
# Model ID for the selected provider.
#   gemini    -> gemini-3.5-flash-lite (image input, free tier, fast)
#   anthropic -> claude-haiku-5-5 (kept for later)
VISION_MODEL=gemini-3.5-flash-lite
# Google Gemini API key. Absent => mock provider + a startup warning.
# Free tier: Google may use submitted content to improve its products. We send
# product photos only, never student data. See README for details.
GEMINI_API_KEY=
# Anthropic API key, kept for later; unused while VISION_PROVIDER=gemini.
ANTHROPIC_API_KEY=

# --- Persistence (Supabase) ---
# When BOTH are set, the app uses Supabase; otherwise the in-memory store
# (local dev + tests). SERVER-ONLY. Writes use ONLY the service-role key, never
# the NEXT_PUBLIC_* / anon / publishable keys. Run migrations 001-004 first.
# On Vercel, the Supabase Marketplace integration injects these automatically.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# (Vercel also injects NEXT_PUBLIC_SUPABASE_*, POSTGRES_*, SUPABASE_ANON_KEY,
#  SUPABASE_JWT_SECRET, etc. This app does not use those.)
