# Pantry Network — environment variables (example)
# Copy to .env.local for local dev. NEVER commit a real .env file (R14.2).
# All secrets are server-only. Never prefix any key with NEXT_PUBLIC_ (R14.1).

# --- Staff access gate ---
# PIN staff type to unlock intake. May be shared publicly with testers.
STAFF_PIN=1234
# HMAC signing key for the session token. Independent of STAFF_PIN.
# Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Campus ---
CAMPUS_ID=campus-a
CAMPUS_TZ=America/New_York

# --- Vision provider ---
# VISION_PROVIDER: "gemini" | "anthropic" | "mock". Falls back to mock if the
# selected provider has no API key. Gemini is the current default (free tier).
VISION_PROVIDER=gemini
# Model ID for the selected provider.
#   gemini    -> gemini-3.8-flash (multimodal, accepts image input, free tier)
#   anthropic -> claude-haiku-5-5 (kept for later)
VISION_MODEL=gemini-3.8-flash
# Google Gemini API key. Absent => mock provider + startup warning (R6.4, R6.14).
# Free tier: Google may use submitted content to improve its products. We send
# product photos only, never student data. See README for details.
GEMINI_API_KEY=
# Anthropic API key — kept for later; unused while VISION_PROVIDER=gemini.
ANTHROPIC_API_KEY=

# --- Persistence (Supabase) ---
# When BOTH are set, the app uses the Supabase repository; otherwise in-memory.
# Server-only; the service-role key must never reach the client.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
